{% load i18n l10n financial %}<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!DOCTYPE document SYSTEM "rml.dtd">
<document filename="{{ object.number }}" xmlns:doc="http://namespaces.zope.org/rml/doc">

    <docinit doc:example="">
        <registerTTFont faceName="Fixed" fileName="Vera.ttf" doc:example="" />
        <registerTTFont faceName="Sans" fileName="{{ fontdir }}/LiberationSans-Regular.ttf" doc:example="" />
        <registerTTFont faceName="SansItalic" fileName="{{ fontdir }}/LiberationSans-Italic.ttf" doc:example="" />
        <registerTTFont faceName="SansBold" fileName="{{ fontdir }}/LiberationSans-Bold.ttf" doc:example="" />
    </docinit>

    <template author="{{ object.issuer_name }}" title="Faktura {{ object.issuer_name }} {{ object.number }}" leftMargin="1cm" topMargin="0.5cm" rightMargin="1cm" bottomMargin="0.5cm">
        <pageTemplate id="main">
            <frame id="content" x1="1cm" y1="0cm" width="19cm" height="277mm"/>
            <frame id="footer" x1="1cm" y1="0mm" width="19cm" height="10mm"/>
        </pageTemplate>
    </template>

    <stylesheet>
        <paraStyle name="P1" fontName="Sans" fontSize="10" leading="13"/>
        <paraStyle name="Footer" fontName="SansItalic" fontSize="9" leading="12"/>
        <paraStyle name="BusinessEntity" fontName="Sans" fontSize="8" leading="12"/>
        <paraStyle name="P2" parent="P1" alignment="RIGHT"/>
        <paraStyle name="FrameHeader" parent="P1" alignment="center" backColor="#eaeaea" fontName="SansBold" spaceBefore="0" spaceAfter="0" leading="15"/>
        <paraStyle name="FrameBodySmall" parent="P2" alignment="CENTER" leading="21" />
        <paraStyle name="FrameBody" parent="P2" alignment="LEFT" leading="14" />
        <paraStyle name="H1" fontName="SansBold" fontSize="14" leading="16" spaceAfter="0.1cm"/>
        <paraStyle name="Title" parent="H1" alignment="CENTER" />
        <paraStyle name="H3" fontName="SansBold" fontSize="10" leading="12" spaceAfter="0.1cm"/>
        <paraStyle name="P9" fontName="Sans" fontSize="6" leading="7" alignment="CENTER"/>
        <paraStyle name="P8" parent="P9" alignment="RIGHT"/>
        <paraStyle name="P7" parent="P9" alignment="RIGHT"/>
        <paraStyle name="P6" parent="P9" alignment="LEFT"/>
        <blockTableStyle id="Tabela1">
            <blockAlignment value="LEFT"/>
            <blockValign value="TOP"/>
        </blockTableStyle>

        <blockTableStyle id="Frame">
            <lineStyle kind="LINEABOVE" colorName="#666666" thickness="0.01cm" />
            <lineStyle kind="LINEBELOW" colorName="#666666" thickness="0.01cm" />
            <blockLeading length="0.3cm" />
            <blockTopPadding length="0cm" />
            <blockBottomPadding length="0cm" />
            <blockRightPadding length="0cm" />
            <blockLeftPadding length="0cm" />
            <blockValign value="MIDDLE"/>
            <blockAlignment value="CENTER"/>
        </blockTableStyle>

        <blockTableStyle id="FrameBorder">
            <lineStyle kind="GRID" colorName="#666666" thickness="0.01cm" />
            <blockLeading length="0.3cm" />
            <blockTopPadding length="0cm" />
            <blockBottomPadding length="0cm" />
            <blockRightPadding length="0cm" />
            <blockLeftPadding length="0cm" />
            <blockValign value="MIDDLE"/>
            <blockAlignment value="CENTER"/>
        </blockTableStyle>

        <blockTableStyle id="Products">
            <blockAlignment value="LEFT"/>
            <blockValign value="MIDDLE"/>
            <lineStyle kind="GRID" colorName="#000000" start="0,0" stop="-1,-2" thickness="0.01cm"/>
            <lineStyle kind="GRID" colorName="#000000" start="6,-1" stop="-1,-1" thickness="0.01cm" />
            <blockBackground colorName="#eaeaea" start="0,0" stop="-1,0" />
            <blockSpan start="0,-1" stop="5,-1" doc:example="" />
        </blockTableStyle>

        <blockTableStyle id="TaxInfo">
            <blockAlignment value="LEFT"/>
            <blockValign value="MIDDLE"/>
            <lineStyle kind="GRID" colorName="#000000" start="6,0" stop="-1,-1" thickness="0.01cm"/>
            <blockBackground colorName="#eaeaea" start="6,0" stop="-1,0" thickness="0.01cm" />
            <blockSpan start="0,0" stop="5,0" doc:example="" />
        </blockTableStyle>
    </stylesheet>

    <story>
        <blockTable colWidths="30%,40%,30%" style="Tabela1">
            <tr>
                <td>
                    {% if object.seller.logo %}
                    <imageAndFlowables imageName="{{ object.seller.logo.path }}"></imageAndFlowables>
                    {% else %}
                    <para style="BusinessEntity">
                        <strong>{{ object.seller.name }}</strong><br />
                        {{ object.seller.address }}, {{ object.seller.postal_code }} {{ object.seller.city }}<br />
                        {% if object.seller.phone %}Tel. {{ object.seller.phone }}<br />{% endif %}
                        {% if object.seller.email %}Email: {{ object.seller.email }}<br />{% endif %}
                        {% if object.seller.bank_name %}{{ object.seller.bank_name }}<br />{% endif %}
                        {% if object.seller.iban %}{{ object.seller.iban }}<br />{% endif %}
                    </para>
                    {% endif %}
                </td>
                <td>
                    <para style="Title" fontName="SansBold">Faktura VAT {{ object.number_fmt }}<br/>{% if copy %}KOPIA{% else %}ORYGINAŁ{% endif %}</para>
                </td>
                <td>
                    <blockTable style="Frame"><tr><td>
                                <para style="FrameHeader">Miejsce wystawienia:</para>
                                <para style="FrameBodySmall">{{ object.issue_city }}</para>
                    </td></tr></blockTable>
                    <blockTable style="Frame"><tr><td>
                                <para style="FrameHeader">Data sprzedaży:</para>
                                <para style="FrameBodySmall">{{ object.operation_date|date }}</para>
                    </td></tr></blockTable>
                    <blockTable style="Frame"><tr><td>
                                <para style="FrameHeader">Data wystawienia:</para>
                                <para style="FrameBodySmall">{{ object.issue_date|date }}</para>
                    </td></tr></blockTable>
                </td>
            </tr>
        </blockTable>
        <spacer length="1cm"/>
        <blockTable colWidths="50%,50%" style="Tabela1">
            <tr>
                <td>
                    <blockTable style="Frame"><tr><td>
                                <para style="FrameHeader">
                                    <h3 style="H3">Sprzedawca</h3>
                                </para>
                                <para style="FrameBody">
                                    {{ object.seller.name }}<br/>
                                    {{ object.seller.address }}, {{ object.seller.postal_code }} {{ object.seller.city }}<br />
                                    NIP: {{ object.seller.nip }}
                                </para>
                    </td></tr></blockTable>
                </td>
                <td>
                    <blockTable style="Frame"><tr><td>
                                <para style="FrameHeader">
                                    <h3 style="H3">Nabywca</h3>
                                </para>
                                <para style="FrameBody">
                                    {{ object.buyer.name }}<br />
                                    {{ object.buyer.address }}, {{ object.buyer.postal_code }} {{ object.buyer.city }}<br />
                                    NIP: {{ object.buyer.nip }}
                                </para>
                    </td></tr></blockTable>
                </td>
            </tr>
        </blockTable>

        <spacer length="1cm"/>

        <blockTable colWidths="22.0,196.0,35.0,21.0,26.0,49.0,41.0,41.0,40.0,39.0" style="Products">
            <tr>
                <td>
                    <para style="P9">Lp.</para>
                </td>
                <td>
                    <para style="P9">Nazwa produktu, towaru lub usługi</para>
                </td>
                <td>
                    <para style="P9">PKWiU</para>
                </td>
                <td>
                    <para style="P9">J.m.</para>
                </td>
                <td>
                    <para style="P9">Ilość</para>
                </td>
                <td>
                    <para style="P9">Cena netto</para>
                </td>
                <td>
                    <para style="P9">Stawka VAT</para>
                </td>
                <td>
                    <para style="P9">Wartość netto</para>
                </td>
                <td>
                    <para style="P9">Kwota VAT</para>
                </td>
                <td>
                    <para style="P9">Wartość brutto</para>
                </td>
            </tr>
            {% for item in object.saleinvoiceline_set.all %}
            <tr>
                <td>
                    <para style="P7">{{ forloop.counter }}</para>
                </td>
                <td>
                    <para style="P6">{{ item.product_name }}</para>
                </td>
                <td>
                    <para style="P7">{{ item.pkwiu }}</para>
                </td>
                <td>
                    <para style="P7">{{ item.unit_name }}</para>
                </td>
                <td>
                    <para style="P7">{{ item.quantity }}</para>
                </td>
                <td>
                    <para style="P7">{{ item.price_net }}</para>
                </td>
                <td>
                    <para style="P7" alignment="CENTER">{{ item.tax_rate_prc }}</para>
                </td>
                <td>
                    <para style="P7">{{ item.total_net }}</para>
                </td>
                <td>
                    <para style="P7">{{ item.tax_value }}</para>
                </td>
                <td>
                    <para style="P7">{{ item.total_gross }}</para>
                </td>
            </tr>
            {% endfor %}
            <tr>
                <td><para style="P8">Razem:</para></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td>
                    <para style="P7">{{ object.total_net }}</para>
                </td>
                <td>
                    <para style="P7">{{ object.total_tax_value }}</para>
                </td>
                <td>
                    <para style="P7">{{ object.total_gross }}</para>
                </td>
            </tr>
        </blockTable>
        <spacer length="5mm"/>
        <blockTable colWidths="42.0,176.0,35.0,21.0,16.0,10,90.0,41.0,40.0,39.0" style="TaxInfo">
            <tr><td><para style="P8">W tym:</para></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td>
                    <para style="P9">Stawka VAT</para>
                </td>
                <td>
                    <para style="P9">Wartość netto</para>
                </td>
                <td>
                    <para style="P9">Kwota VAT</para>
                </td>
                <td>
                    <para style="P9">Wartość brutto</para>
                </td>
            </tr>
            {% for s in object.tax_summary %}
            <tr>
                <td><para style="P8"></para></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td>
                    <para style="P7">{{ s.tax__name }}</para>
                </td>
                <td>
                    <para style="P7">{{ s.total_net }}</para>
                </td>
                <td>
                    <para style="P7">{{ s.tax_value }}</para>
                </td>
                <td>
                    <para style="P7">{{ s.total_gross}}</para>
                </td>
            </tr>
            {% endfor %}
        </blockTable>

        <spacer length="0.5cm" />

        <blockTable colWidths="30%,70%">
            <tr>
                <td></td>
                <td>
                    <blockTable style="Frame">
                        <tr>
                            <td>
                                <para style="FrameHeader" alignment="LEFT" fontSize="16" leading="24">
                                    Do zapłaty: {{ object.total_gross }} {{ object.currency }}
                                </para>
                                <para style="FrameBodySmall" alignment="LEFT" spaceBefore="0.2cm">
                                    Słownie: {{ object.total_gross|as_words }}
                                </para>
                            </td>
                        </tr>
                    </blockTable>
                </td>
            </tr>           
        </blockTable>

        <spacer length="1cm"/>

        {% if object.paid %}
        <para style="P1">Zapłacono: {{ object.total_paid }} {{ object.currency }}</para>
        {% else %}  
        <para style="P1">
            Do zapłaty: {{ object.total_unpaid }} {{ object.currency }}<br />
            Sposób płatności: {{ object.payment_type.name }}<br />
            {% if object.pay_date %}Termin płatności: {{ object.pay_date|date }} ({{ object.pay_date_days }} dni)<br />{% endif %}
            {% if object.payment_type.transfer %}Nr rachunku: {{ object.seller.iban }}{% endif %}
        </para>
        {% endif %}

        <spacer length="1cm"/>

        <blockTable colWidths="40%,20%,40%">
            <tr>
                <td>
                    <blockTable style="FrameBorder" rowHeights="20,3cm">
                        <tr>
                            <td>
                                <para style="FrameHeader">Wystawił(a):</para>
                            </td>
                        </tr>
                        <tr>
                            <td vAlign="TOP">
                                <para style="FrameBodySmall">{{ object.issuer_full_name|default:" " }}</para>
                            </td>
                        </tr>
                    </blockTable>
                </td>
                <td></td>
                <td>
                    <blockTable style="FrameBorder" rowHeights="20,3cm">
                        <tr>
                            <td>
                                <para style="FrameHeader">Odebrał(a):</para>
                            </td>
                        </tr>
                        <tr>
                            <td vAlign="TOP">
                                <para style="FrameBodySmall">{{ object.receiver_full_name|default:" " }}</para>
                            </td>
                        </tr>
                    </blockTable>
                </td>
            </tr>
        </blockTable>
        <nextFrame/>
        <para style="Footer">Wygenerowano za pomocą programu Sellnov - Faktury Online v0.1 NTSmedia Marcin Nowak</para>
    {% if object.comment %}
        <nextFrame/>
        <pageBreak/>
        <para style="H1">Uwagi:</para>
        <para style="FrameBody">{{ object.comment|linebreaksbr }}</para>
    {% endif %}
    </story>

</document>
